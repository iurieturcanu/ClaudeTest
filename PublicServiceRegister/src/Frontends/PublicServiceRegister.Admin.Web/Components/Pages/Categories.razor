@page "/categories"
@using PublicServiceRegister.Admin.Web.Services
@using PublicServiceRegister.Contracts
@inject ApiService ApiService
@rendermode InteractiveServer

<PageTitle>Categories - Admin Portal</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Service Categories</h1>
    <button class="btn btn-primary" @onclick="ShowCreateModal">Add Category</button>
</div>

@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (categories != null)
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Status</th>
                <th>Version</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in categories)
            {
                <tr>
                    <td>@category.Name</td>
                    <td>@category.Description</td>
                    <td>
                        @if (category.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>v@category.Version</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowEditModal(category)">Edit</button>
                        @if (category.IsActive)
                        {
                            <button class="btn btn-sm btn-outline-warning" @onclick="() => DeactivateCategory(category.Id)">Deactivate</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-success" @onclick="() => ActivateCategory(category.Id)">Activate</button>
                        }
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCategory(category.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (showModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditing ? "Edit Category" : "Create Category")</h5>
                    <button type="button" class="btn-close" @onclick="HideModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@formModel" OnValidSubmit="HandleSubmit">
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <InputText @bind-Value="formModel.Name" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <InputTextArea @bind-Value="formModel.Description" class="form-control" rows="3" />
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="HideModal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Save</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ServiceCategoryDto>? categories;
    private bool isLoading = true;
    private bool showModal = false;
    private bool isEditing = false;
    private Guid? editingId;
    private CategoryFormModel formModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
    }

    private async Task LoadCategories()
    {
        isLoading = true;
        try
        {
            categories = await ApiService.GetAsync<List<ServiceCategoryDto>>("api/categories");
        }
        catch
        {
            categories = new List<ServiceCategoryDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowCreateModal()
    {
        formModel = new CategoryFormModel();
        isEditing = false;
        editingId = null;
        showModal = true;
    }

    private void ShowEditModal(ServiceCategoryDto category)
    {
        formModel = new CategoryFormModel { Name = category.Name, Description = category.Description };
        isEditing = true;
        editingId = category.Id;
        showModal = true;
    }

    private void HideModal()
    {
        showModal = false;
    }

    private async Task HandleSubmit()
    {
        try
        {
            if (isEditing && editingId.HasValue)
            {
                await ApiService.PutAsync($"api/categories/{editingId}", new UpdateCategoryRequest(formModel.Name, formModel.Description));
            }
            else
            {
                await ApiService.PostAsync<CreateCategoryRequest, Guid>("api/categories", new CreateCategoryRequest(formModel.Name, formModel.Description));
            }
            HideModal();
            await LoadCategories();
        }
        catch
        {
            // Handle error
        }
    }

    private async Task ActivateCategory(Guid id)
    {
        await ApiService.PostAsync($"api/categories/{id}/activate");
        await LoadCategories();
    }

    private async Task DeactivateCategory(Guid id)
    {
        await ApiService.PostAsync($"api/categories/{id}/deactivate");
        await LoadCategories();
    }

    private async Task DeleteCategory(Guid id)
    {
        await ApiService.DeleteAsync($"api/categories/{id}");
        await LoadCategories();
    }

    private class CategoryFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
    }
}
