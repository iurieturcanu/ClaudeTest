@page "/services/{Id:int}"
@using PublicServiceRegister.Models
@using PublicServiceRegister.Services
@inject IPublicServiceRepository ServiceRepository
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>@(service?.Name ?? "Service Details") - Public Service Register</PageTitle>

@if (service != null)
{
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/services">Services</a></li>
                @if (service.Category != null)
                {
                    <li class="breadcrumb-item"><a href="/services/category/@service.CategoryId">@service.Category.Name</a></li>
                }
                <li class="breadcrumb-item active">@service.Name</li>
            </ol>
        </nav>

        <div class="row">
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h2 class="mb-0">@service.Name</h2>
                        <span class="badge bg-@GetStatusColor(service.Status) fs-6">@service.Status</span>
                    </div>
                    <div class="card-body">
                        @if (service.Category != null)
                        {
                            <p>
                                <span class="badge bg-secondary fs-6">
                                    <i class="@service.Category.IconClass"></i> @service.Category.Name
                                </span>
                            </p>
                        }

                        <h5>Description</h5>
                        <p class="lead">@service.Description</p>

                        <hr />

                        <div class="row">
                            <div class="col-md-6">
                                <h5><i class="bi bi-building"></i> Provider</h5>
                                <p>@service.Provider</p>
                            </div>
                            <div class="col-md-6">
                                <h5><i class="bi bi-clock"></i> Operating Hours</h5>
                                <p>@(string.IsNullOrEmpty(service.OperatingHours) ? "Not specified" : service.OperatingHours)</p>
                            </div>
                        </div>

                        @if (service.Fee.HasValue || !string.IsNullOrEmpty(service.FeeDescription))
                        {
                            <hr />
                            <h5><i class="bi bi-currency-dollar"></i> Fees</h5>
                            @if (service.Fee.HasValue)
                            {
                                <p class="fs-4">
                                    @if (service.Fee.Value == 0)
                                    {
                                        <span class="text-success fw-bold">Free</span>
                                    }
                                    else
                                    {
                                        <span>$@service.Fee.Value.ToString("N2")</span>
                                    }
                                </p>
                            }
                            @if (!string.IsNullOrEmpty(service.FeeDescription))
                            {
                                <p class="text-muted">@service.FeeDescription</p>
                            }
                        }

                        @if (service.RequiredDocuments != null && service.RequiredDocuments.Any())
                        {
                            <hr />
                            <h5><i class="bi bi-file-earmark-text"></i> Required Documents</h5>
                            <ul class="list-group list-group-flush">
                                @foreach (var doc in service.RequiredDocuments)
                                {
                                    <li class="list-group-item">
                                        <i class="bi bi-check-circle text-success"></i> @doc
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                    <div class="card-footer text-muted">
                        <small>
                            Created: @service.CreatedAt.ToString("MMMM dd, yyyy")
                            @if (service.UpdatedAt.HasValue)
                            {
                                <span> | Last Updated: @service.UpdatedAt.Value.ToString("MMMM dd, yyyy")</span>
                            }
                        </small>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-geo-alt"></i> Location & Contact</h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(service.Address))
                        {
                            <p>
                                <strong>Address:</strong><br />
                                @service.Address
                            </p>
                        }

                        @if (!string.IsNullOrEmpty(service.ContactPhone))
                        {
                            <p>
                                <strong>Phone:</strong><br />
                                <a href="tel:@service.ContactPhone" class="text-decoration-none">
                                    <i class="bi bi-telephone"></i> @service.ContactPhone
                                </a>
                            </p>
                        }

                        @if (!string.IsNullOrEmpty(service.ContactEmail))
                        {
                            <p>
                                <strong>Email:</strong><br />
                                <a href="mailto:@service.ContactEmail" class="text-decoration-none">
                                    <i class="bi bi-envelope"></i> @service.ContactEmail
                                </a>
                            </p>
                        }

                        @if (!string.IsNullOrEmpty(service.Website))
                        {
                            <p>
                                <strong>Website:</strong><br />
                                <a href="@service.Website" target="_blank" rel="noopener noreferrer" class="text-decoration-none">
                                    <i class="bi bi-globe"></i> Visit Website
                                </a>
                            </p>
                        }
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-gear"></i> Actions</h5>
                    </div>
                    <div class="card-body d-grid gap-2">
                        <a href="/services/manage/@service.Id" class="btn btn-primary">
                            <i class="bi bi-pencil"></i> Edit Service
                        </a>
                        <button class="btn btn-outline-danger" @onclick="ShowDeleteConfirm">
                            <i class="bi bi-trash"></i> Delete Service
                        </button>
                        <a href="/services" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back to Services
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (showDeleteConfirm)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirm Delete</h5>
                        <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                    </div>
                    <div class="modal-body">
                        <p>Are you sure you want to delete <strong>@service.Name</strong>?</p>
                        <p class="text-danger">This action cannot be undone.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                        <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>
                    </div>
                </div>
            </div>
        </div>
    }
}
else if (notFound)
{
    <div class="container">
        <div class="alert alert-warning">
            <h4><i class="bi bi-exclamation-triangle"></i> Service Not Found</h4>
            <p>The requested service could not be found.</p>
            <a href="/services" class="btn btn-primary">Browse All Services</a>
        </div>
    </div>
}
else
{
    <div class="container d-flex justify-content-center py-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private PublicService? service;
    private bool notFound = false;
    private bool showDeleteConfirm = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadService();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadService();
    }

    private async Task LoadService()
    {
        service = await ServiceRepository.GetByIdAsync(Id);
        notFound = service == null;
    }

    private void ShowDeleteConfirm()
    {
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
    }

    private async Task ConfirmDelete()
    {
        if (service != null)
        {
            await ServiceRepository.DeleteAsync(service.Id);
            Navigation.NavigateTo("/services");
        }
    }

    private string GetStatusColor(ServiceStatus status) => status switch
    {
        ServiceStatus.Active => "success",
        ServiceStatus.Inactive => "secondary",
        ServiceStatus.UnderReview => "warning",
        ServiceStatus.Deprecated => "danger",
        _ => "secondary"
    };
}
