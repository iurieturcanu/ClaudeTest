@page "/categories"
@using PublicServiceRegister.Models
@using PublicServiceRegister.Services
@inject ICategoryRepository CategoryRepository
@inject IPublicServiceRepository ServiceRepository
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Categories - Public Service Register</PageTitle>

<div class="container-fluid">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active">Categories</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Service Categories</h1>
        <button class="btn btn-primary" @onclick="ShowAddModal">
            <i class="bi bi-plus-circle"></i> Add Category
        </button>
    </div>

    @if (categories != null)
    {
        <div class="row">
            @foreach (var category in categories)
            {
                var serviceCount = serviceCounts.GetValueOrDefault(category.Id, 0);
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <i class="@category.IconClass display-5 me-3 text-primary"></i>
                                <div>
                                    <h5 class="card-title mb-0">@category.Name</h5>
                                    <small class="text-muted">@serviceCount service(s)</small>
                                </div>
                            </div>
                            <p class="card-text">@category.Description</p>
                        </div>
                        <div class="card-footer bg-transparent">
                            <div class="btn-group btn-group-sm w-100">
                                <a href="/services/category/@category.Id" class="btn btn-outline-primary">
                                    <i class="bi bi-eye"></i> View Services
                                </a>
                                <button class="btn btn-outline-secondary" @onclick="() => EditCategory(category)">
                                    <i class="bi bi-pencil"></i> Edit
                                </button>
                                <button class="btn btn-outline-danger" @onclick="() => DeleteCategory(category)"
                                        disabled="@(serviceCount > 0)">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
</div>

@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingCategory != null ? "Edit Category" : "Add Category")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <EditForm Model="@categoryModel" OnValidSubmit="SaveCategory">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="catName" class="form-label">Name *</label>
                            <InputText id="catName" class="form-control" @bind-Value="categoryModel.Name" />
                        </div>
                        <div class="mb-3">
                            <label for="catDesc" class="form-label">Description</label>
                            <InputTextArea id="catDesc" class="form-control" rows="3" @bind-Value="categoryModel.Description" />
                        </div>
                        <div class="mb-3">
                            <label for="catIcon" class="form-label">Icon Class</label>
                            <InputText id="catIcon" class="form-control" @bind-Value="categoryModel.IconClass"
                                       placeholder="bi bi-folder" />
                            <small class="text-muted">
                                Use Bootstrap Icons classes. Preview: <i class="@categoryModel.IconClass"></i>
                            </small>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            @(editingCategory != null ? "Update" : "Create")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (showDeleteConfirm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete the <strong>@categoryToDelete?.Name</strong> category?</p>
                    <p class="text-danger">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IEnumerable<ServiceCategory>? categories;
    private Dictionary<int, int> serviceCounts = new();
    private bool showModal = false;
    private bool showDeleteConfirm = false;
    private ServiceCategory? editingCategory;
    private ServiceCategory? categoryToDelete;
    private ServiceCategory categoryModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
    }

    private async Task LoadCategories()
    {
        categories = await CategoryRepository.GetAllAsync();
        var allServices = await ServiceRepository.GetAllAsync();

        serviceCounts = allServices
            .GroupBy(s => s.CategoryId)
            .ToDictionary(g => g.Key, g => g.Count());
    }

    private void ShowAddModal()
    {
        editingCategory = null;
        categoryModel = new ServiceCategory { IconClass = "bi bi-folder" };
        showModal = true;
    }

    private void EditCategory(ServiceCategory category)
    {
        editingCategory = category;
        categoryModel = new ServiceCategory
        {
            Id = category.Id,
            Name = category.Name,
            Description = category.Description,
            IconClass = category.IconClass
        };
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        editingCategory = null;
        categoryModel = new();
    }

    private async Task SaveCategory()
    {
        if (string.IsNullOrWhiteSpace(categoryModel.Name))
            return;

        if (editingCategory != null)
        {
            await CategoryRepository.UpdateAsync(categoryModel);
        }
        else
        {
            await CategoryRepository.AddAsync(categoryModel);
        }

        CloseModal();
        await LoadCategories();
    }

    private void DeleteCategory(ServiceCategory category)
    {
        categoryToDelete = category;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        categoryToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (categoryToDelete != null)
        {
            await CategoryRepository.DeleteAsync(categoryToDelete.Id);
            await LoadCategories();
        }
        showDeleteConfirm = false;
        categoryToDelete = null;
    }
}
