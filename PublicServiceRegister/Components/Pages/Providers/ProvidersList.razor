@page "/providers"
@using PublicServiceRegister.Models
@using PublicServiceRegister.Services
@inject IServiceProviderRepository ProviderRepository
@inject IPublicServiceRepository ServiceRepository
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Service Providers - Public Service Register</PageTitle>

<div class="container-fluid">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active">Service Providers</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Service Providers</h1>
        <a href="/providers/manage" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add New Provider
        </a>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Search providers..."
                       @bind="filterTerm" @bind:event="oninput" />
                <button class="btn btn-outline-secondary" @onclick="ClearFilter" title="Clear filter">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="selectedTypeFilter">
                <option value="">All Types</option>
                @foreach (var type in Enum.GetValues<ProviderType>())
                {
                    <option value="@type">@type</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="selectedStatusFilter">
                <option value="">All Statuses</option>
                <option value="true">Active</option>
                <option value="false">Inactive</option>
            </select>
        </div>
    </div>

    @if (filteredProviders != null && filteredProviders.Any())
    {
        <div class="row">
            @foreach (var provider in filteredProviders)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span class="badge bg-@GetTypeColor(provider.Type)">@provider.Type</span>
                            @if (provider.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">@provider.Name</h5>
                            <p class="card-text text-muted small">@TruncateText(provider.Description, 100)</p>

                            @if (!string.IsNullOrEmpty(provider.ContactEmail))
                            {
                                <p class="card-text mb-1">
                                    <small><i class="bi bi-envelope"></i> @provider.ContactEmail</small>
                                </p>
                            }
                            @if (!string.IsNullOrEmpty(provider.ContactPhone))
                            {
                                <p class="card-text mb-1">
                                    <small><i class="bi bi-telephone"></i> @provider.ContactPhone</small>
                                </p>
                            }

                            <p class="card-text mt-2">
                                <small class="text-muted">
                                    <i class="bi bi-list-check"></i> @(serviceCounts.GetValueOrDefault(provider.Id, 0)) service(s)
                                </small>
                            </p>

                            <p class="card-text">
                                <small class="text-muted">
                                    Version @provider.Version
                                    @if (provider.UpdatedAt.HasValue)
                                    {
                                        <span> | Updated: @provider.UpdatedAt.Value.ToString("MMM dd, yyyy")</span>
                                    }
                                </small>
                            </p>
                        </div>
                        <div class="card-footer bg-transparent">
                            <div class="btn-group btn-group-sm w-100">
                                <a href="/providers/@provider.Id" class="btn btn-outline-primary">
                                    <i class="bi bi-eye"></i> View
                                </a>
                                <a href="/providers/manage/@provider.Id" class="btn btn-outline-secondary">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <button class="btn btn-outline-danger" @onclick="() => DeleteProvider(provider)"
                                        disabled="@(serviceCounts.GetValueOrDefault(provider.Id, 0) > 0)">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <p class="text-muted">Showing @filteredProviders.Count() of @(providers?.Count() ?? 0) providers</p>
    }
    else if (providers != null && !providers.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No service providers found.
            <a href="/providers/manage" class="alert-link">Add a new provider</a>
        </div>
    }
    else if (filteredProviders != null && !filteredProviders.Any())
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i> No providers match your filter criteria.
            <button class="btn btn-link p-0 alert-link" @onclick="ClearAllFilters">Clear all filters</button>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
</div>

@if (showDeleteConfirm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete <strong>@providerToDelete?.Name</strong>?</p>
                    <p class="text-danger">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IEnumerable<ServiceProvider>? providers;
    private Dictionary<int, int> serviceCounts = new();
    private string filterTerm = string.Empty;
    private string selectedTypeFilter = string.Empty;
    private string selectedStatusFilter = string.Empty;
    private bool showDeleteConfirm = false;
    private ServiceProvider? providerToDelete;

    private IEnumerable<ServiceProvider>? filteredProviders => providers?.Where(p =>
        (string.IsNullOrEmpty(filterTerm) ||
         p.Name.Contains(filterTerm, StringComparison.OrdinalIgnoreCase) ||
         p.Description.Contains(filterTerm, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(selectedTypeFilter) || p.Type.ToString() == selectedTypeFilter) &&
        (string.IsNullOrEmpty(selectedStatusFilter) || p.IsActive.ToString().ToLower() == selectedStatusFilter.ToLower())
    );

    protected override async Task OnInitializedAsync()
    {
        await LoadProviders();
    }

    private async Task LoadProviders()
    {
        providers = await ProviderRepository.GetAllAsync();
        var allServices = await ServiceRepository.GetAllAsync();

        serviceCounts = allServices
            .Where(s => s.ServiceProviderId.HasValue)
            .GroupBy(s => s.ServiceProviderId!.Value)
            .ToDictionary(g => g.Key, g => g.Count());
    }

    private void ClearFilter()
    {
        filterTerm = string.Empty;
    }

    private void ClearAllFilters()
    {
        filterTerm = string.Empty;
        selectedTypeFilter = string.Empty;
        selectedStatusFilter = string.Empty;
    }

    private void DeleteProvider(ServiceProvider provider)
    {
        providerToDelete = provider;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        providerToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (providerToDelete != null)
        {
            await ProviderRepository.DeleteAsync(providerToDelete.Id);
            await LoadProviders();
        }
        showDeleteConfirm = false;
        providerToDelete = null;
    }

    private string TruncateText(string text, int maxLength)
    {
        if (string.IsNullOrEmpty(text) || text.Length <= maxLength)
            return text;
        return text.Substring(0, maxLength) + "...";
    }

    private string GetTypeColor(ProviderType type) => type switch
    {
        ProviderType.Government => "primary",
        ProviderType.Municipal => "info",
        ProviderType.StateAgency => "success",
        ProviderType.FederalAgency => "danger",
        ProviderType.NonProfit => "warning",
        ProviderType.PrivateContractor => "secondary",
        ProviderType.PublicPrivatePartnership => "dark",
        _ => "secondary"
    };
}
