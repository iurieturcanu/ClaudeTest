@page "/services"
@page "/services/category/{CategoryId:int}"
@using PublicServiceRegister.Models
@using PublicServiceRegister.Services
@inject IPublicServiceRepository ServiceRepository
@inject ICategoryRepository CategoryRepository
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>@(currentCategory != null ? $"{currentCategory.Name} Services" : "All Services") - Public Service Register</PageTitle>

<div class="container-fluid">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            @if (currentCategory != null)
            {
                <li class="breadcrumb-item"><a href="/services">All Services</a></li>
                <li class="breadcrumb-item active">@currentCategory.Name</li>
            }
            else
            {
                <li class="breadcrumb-item active">All Services</li>
            }
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>@(currentCategory != null ? $"{currentCategory.Name} Services" : "All Public Services")</h1>
            @if (currentCategory != null)
            {
                <p class="text-muted">@currentCategory.Description</p>
            }
        </div>
        <a href="/services/manage" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add New Service
        </a>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Filter services..."
                       @bind="filterTerm" @bind:event="oninput" />
                <button class="btn btn-outline-secondary" @onclick="ClearFilter" title="Clear filter">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="selectedCategoryFilter">
                <option value="0">All Categories</option>
                @if (categories != null)
                {
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="selectedStatusFilter">
                <option value="">All Statuses</option>
                @foreach (var status in Enum.GetValues<ServiceStatus>())
                {
                    <option value="@status">@status</option>
                }
            </select>
        </div>
    </div>

    @if (filteredServices != null && filteredServices.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Service Name</th>
                        <th>Category</th>
                        <th>Provider</th>
                        <th>Status</th>
                        <th>Contact</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var service in filteredServices)
                    {
                        <tr>
                            <td>
                                <a href="/services/@service.Id" class="text-decoration-none fw-bold">
                                    @service.Name
                                </a>
                            </td>
                            <td>
                                @if (service.Category != null)
                                {
                                    <span class="badge bg-secondary">@service.Category.Name</span>
                                }
                            </td>
                            <td>@service.Provider</td>
                            <td>
                                <span class="badge bg-@GetStatusColor(service.Status)">@service.Status</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(service.ContactPhone))
                                {
                                    <small><i class="bi bi-telephone"></i> @service.ContactPhone</small>
                                }
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a href="/services/@service.Id" class="btn btn-outline-primary" title="View">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="/services/manage/@service.Id" class="btn btn-outline-secondary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button class="btn btn-outline-danger" title="Delete" @onclick="() => DeleteService(service)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="text-muted">Showing @filteredServices.Count() of @(services?.Count() ?? 0) services</p>
    }
    else if (services != null && !services.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No services found in this category.
            <a href="/services/manage" class="alert-link">Add a new service</a>
        </div>
    }
    else if (filteredServices != null && !filteredServices.Any())
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i> No services match your filter criteria.
            <button class="btn btn-link p-0 alert-link" @onclick="ClearAllFilters">Clear all filters</button>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
</div>

@if (showDeleteConfirm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete <strong>@serviceToDelete?.Name</strong>?</p>
                    <p class="text-danger">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int CategoryId { get; set; }

    private IEnumerable<PublicService>? services;
    private IEnumerable<ServiceCategory>? categories;
    private ServiceCategory? currentCategory;
    private string filterTerm = string.Empty;
    private int selectedCategoryFilter = 0;
    private string selectedStatusFilter = string.Empty;
    private bool showDeleteConfirm = false;
    private PublicService? serviceToDelete;

    private IEnumerable<PublicService>? filteredServices => services?.Where(s =>
        (string.IsNullOrEmpty(filterTerm) ||
         s.Name.Contains(filterTerm, StringComparison.OrdinalIgnoreCase) ||
         s.Provider.Contains(filterTerm, StringComparison.OrdinalIgnoreCase) ||
         s.Description.Contains(filterTerm, StringComparison.OrdinalIgnoreCase)) &&
        (selectedCategoryFilter == 0 || s.CategoryId == selectedCategoryFilter) &&
        (string.IsNullOrEmpty(selectedStatusFilter) || s.Status.ToString() == selectedStatusFilter)
    );

    protected override async Task OnInitializedAsync()
    {
        categories = await CategoryRepository.GetAllAsync();
        await LoadServices();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadServices();
    }

    private async Task LoadServices()
    {
        if (CategoryId > 0)
        {
            currentCategory = await CategoryRepository.GetByIdAsync(CategoryId);
            services = await ServiceRepository.GetByCategoryAsync(CategoryId);
            selectedCategoryFilter = CategoryId;
        }
        else
        {
            currentCategory = null;
            services = await ServiceRepository.GetAllAsync();
        }
    }

    private void ClearFilter()
    {
        filterTerm = string.Empty;
    }

    private void ClearAllFilters()
    {
        filterTerm = string.Empty;
        selectedCategoryFilter = CategoryId > 0 ? CategoryId : 0;
        selectedStatusFilter = string.Empty;
    }

    private void DeleteService(PublicService service)
    {
        serviceToDelete = service;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        serviceToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (serviceToDelete != null)
        {
            await ServiceRepository.DeleteAsync(serviceToDelete.Id);
            await LoadServices();
        }
        showDeleteConfirm = false;
        serviceToDelete = null;
    }

    private string GetStatusColor(ServiceStatus status) => status switch
    {
        ServiceStatus.Active => "success",
        ServiceStatus.Inactive => "secondary",
        ServiceStatus.UnderReview => "warning",
        ServiceStatus.Deprecated => "danger",
        _ => "secondary"
    };
}
