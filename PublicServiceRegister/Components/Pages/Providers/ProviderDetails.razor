@page "/providers/{Id:int}"
@using PublicServiceRegister.Models
@using PublicServiceRegister.Services
@inject IServiceProviderRepository ProviderRepository
@inject IPublicServiceRepository ServiceRepository
@inject IVersionRepository VersionRepository
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>@(provider?.Name ?? "Provider Details") - Public Service Register</PageTitle>

@if (provider != null)
{
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/providers">Service Providers</a></li>
                <li class="breadcrumb-item active">@provider.Name</li>
            </ol>
        </nav>

        <div class="row">
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h2 class="mb-0">@provider.Name</h2>
                        <div>
                            <span class="badge bg-@GetTypeColor(provider.Type) fs-6 me-2">@provider.Type</span>
                            @if (provider.IsActive)
                            {
                                <span class="badge bg-success fs-6">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary fs-6">Inactive</span>
                            }
                        </div>
                    </div>
                    <div class="card-body">
                        <h5>Description</h5>
                        <p class="lead">@provider.Description</p>

                        <hr />

                        <div class="row">
                            <div class="col-md-6">
                                <h5><i class="bi bi-geo-alt"></i> Address</h5>
                                <p>@(string.IsNullOrEmpty(provider.Address) ? "Not specified" : provider.Address)</p>
                            </div>
                            <div class="col-md-6">
                                <h5><i class="bi bi-globe"></i> Website</h5>
                                @if (!string.IsNullOrEmpty(provider.Website))
                                {
                                    <p><a href="@provider.Website" target="_blank" rel="noopener noreferrer">@provider.Website</a></p>
                                }
                                else
                                {
                                    <p>Not specified</p>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="card-footer text-muted">
                        <small>
                            <strong>Version @provider.Version</strong> |
                            Created: @provider.CreatedAt.ToString("MMMM dd, yyyy")
                            @if (provider.UpdatedAt.HasValue)
                            {
                                <span> | Last Updated: @provider.UpdatedAt.Value.ToString("MMMM dd, yyyy")</span>
                            }
                            @if (!string.IsNullOrEmpty(provider.ModifiedBy))
                            {
                                <span> by @provider.ModifiedBy</span>
                            }
                        </small>
                    </div>
                </div>

                <!-- Services provided by this provider -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-list-check"></i> Services Provided (@(providerServices?.Count() ?? 0))</h5>
                    </div>
                    <div class="card-body">
                        @if (providerServices != null && providerServices.Any())
                        {
                            <div class="list-group">
                                @foreach (var service in providerServices)
                                {
                                    <a href="/services/@service.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>@service.Name</strong>
                                            <br />
                                            <small class="text-muted">@TruncateText(service.Description, 80)</small>
                                        </div>
                                        <span class="badge bg-@GetStatusColor(service.Status)">@service.Status</span>
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">No services are currently associated with this provider.</p>
                        }
                    </div>
                </div>

                <!-- Version History -->
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-clock-history"></i> Version History</h5>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleVersionHistory">
                            @(showVersionHistory ? "Hide" : "Show")
                        </button>
                    </div>
                    @if (showVersionHistory)
                    {
                        <div class="card-body">
                            @if (versionHistory != null && versionHistory.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Version</th>
                                                <th>Date</th>
                                                <th>Modified By</th>
                                                <th>Description</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var version in versionHistory)
                                            {
                                                <tr>
                                                    <td><span class="badge bg-secondary">v@version.VersionNumber</span></td>
                                                    <td>@version.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                                    <td>@(version.ModifiedBy ?? "System")</td>
                                                    <td>@(version.ChangeDescription ?? "-")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted mb-0">No version history available.</p>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-telephone"></i> Contact Information</h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(provider.ContactPhone))
                        {
                            <p>
                                <strong>Phone:</strong><br />
                                <a href="tel:@provider.ContactPhone" class="text-decoration-none">
                                    <i class="bi bi-telephone"></i> @provider.ContactPhone
                                </a>
                            </p>
                        }

                        @if (!string.IsNullOrEmpty(provider.ContactEmail))
                        {
                            <p>
                                <strong>Email:</strong><br />
                                <a href="mailto:@provider.ContactEmail" class="text-decoration-none">
                                    <i class="bi bi-envelope"></i> @provider.ContactEmail
                                </a>
                            </p>
                        }

                        @if (string.IsNullOrEmpty(provider.ContactPhone) && string.IsNullOrEmpty(provider.ContactEmail))
                        {
                            <p class="text-muted">No contact information available.</p>
                        }
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-gear"></i> Actions</h5>
                    </div>
                    <div class="card-body d-grid gap-2">
                        <a href="/providers/manage/@provider.Id" class="btn btn-primary">
                            <i class="bi bi-pencil"></i> Edit Provider
                        </a>
                        <button class="btn btn-outline-danger" @onclick="ShowDeleteConfirm"
                                disabled="@(providerServices?.Any() ?? false)">
                            <i class="bi bi-trash"></i> Delete Provider
                        </button>
                        @if (providerServices?.Any() ?? false)
                        {
                            <small class="text-muted">Cannot delete provider with associated services</small>
                        }
                        <a href="/providers" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back to Providers
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (showDeleteConfirm)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirm Delete</h5>
                        <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                    </div>
                    <div class="modal-body">
                        <p>Are you sure you want to delete <strong>@provider.Name</strong>?</p>
                        <p class="text-danger">This action cannot be undone.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                        <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>
                    </div>
                </div>
            </div>
        </div>
    }
}
else if (notFound)
{
    <div class="container">
        <div class="alert alert-warning">
            <h4><i class="bi bi-exclamation-triangle"></i> Provider Not Found</h4>
            <p>The requested service provider could not be found.</p>
            <a href="/providers" class="btn btn-primary">Browse All Providers</a>
        </div>
    </div>
}
else
{
    <div class="container d-flex justify-content-center py-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private ServiceProvider? provider;
    private IEnumerable<PublicService>? providerServices;
    private IEnumerable<Models.Versioning.EntityVersion>? versionHistory;
    private bool notFound = false;
    private bool showDeleteConfirm = false;
    private bool showVersionHistory = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadProvider();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadProvider();
    }

    private async Task LoadProvider()
    {
        provider = await ProviderRepository.GetByIdAsync(Id);
        notFound = provider == null;

        if (provider != null)
        {
            providerServices = await ServiceRepository.GetByProviderAsync(provider.Id);
            versionHistory = await VersionRepository.GetVersionHistoryAsync(nameof(ServiceProvider), provider.Id);
        }
    }

    private void ToggleVersionHistory()
    {
        showVersionHistory = !showVersionHistory;
    }

    private void ShowDeleteConfirm()
    {
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
    }

    private async Task ConfirmDelete()
    {
        if (provider != null)
        {
            await ProviderRepository.DeleteAsync(provider.Id);
            Navigation.NavigateTo("/providers");
        }
    }

    private string TruncateText(string text, int maxLength)
    {
        if (string.IsNullOrEmpty(text) || text.Length <= maxLength)
            return text;
        return text.Substring(0, maxLength) + "...";
    }

    private string GetTypeColor(ProviderType type) => type switch
    {
        ProviderType.Government => "primary",
        ProviderType.Municipal => "info",
        ProviderType.StateAgency => "success",
        ProviderType.FederalAgency => "danger",
        ProviderType.NonProfit => "warning",
        ProviderType.PrivateContractor => "secondary",
        ProviderType.PublicPrivatePartnership => "dark",
        _ => "secondary"
    };

    private string GetStatusColor(ServiceStatus status) => status switch
    {
        ServiceStatus.Active => "success",
        ServiceStatus.Inactive => "secondary",
        ServiceStatus.UnderReview => "warning",
        ServiceStatus.Deprecated => "danger",
        _ => "secondary"
    };
}
