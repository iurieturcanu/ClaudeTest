@page "/providers/manage"
@page "/providers/manage/{Id:int}"
@using PublicServiceRegister.Models
@using PublicServiceRegister.Services
@inject IServiceProviderRepository ProviderRepository
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>@(isEditing ? "Edit Provider" : "Add New Provider") - Public Service Register</PageTitle>

<div class="container-fluid">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a href="/providers">Service Providers</a></li>
            <li class="breadcrumb-item active">@(isEditing ? "Edit Provider" : "Add New Provider")</li>
        </ol>
    </nav>

    <h1>@(isEditing ? "Edit Service Provider" : "Add New Service Provider")</h1>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <EditForm Model="@model" OnValidSubmit="HandleSubmit" FormName="providerForm">
                    <DataAnnotationsValidator />

                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Basic Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label for="name" class="form-label">Provider Name *</label>
                                <InputText id="name" class="form-control" @bind-Value="model.Name" placeholder="Enter provider name" />
                                <ValidationMessage For="@(() => model.Name)" class="text-danger" />
                            </div>

                            <div class="mb-3">
                                <label for="description" class="form-label">Description *</label>
                                <InputTextArea id="description" class="form-control" rows="4" @bind-Value="model.Description"
                                               placeholder="Describe the service provider and their role" />
                                <ValidationMessage For="@(() => model.Description)" class="text-danger" />
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="type" class="form-label">Provider Type *</label>
                                    <InputSelect id="type" class="form-select" @bind-Value="model.Type">
                                        @foreach (var type in Enum.GetValues<ProviderType>())
                                        {
                                            <option value="@type">@type</option>
                                        }
                                    </InputSelect>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="status" class="form-label">Status</label>
                                    <div class="form-check form-switch mt-2">
                                        <InputCheckbox id="isActive" class="form-check-input" @bind-Value="model.IsActive" />
                                        <label class="form-check-label" for="isActive">
                                            @(model.IsActive ? "Active" : "Inactive")
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Contact Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="email" class="form-label">Contact Email</label>
                                    <InputText id="email" type="email" class="form-control" @bind-Value="model.ContactEmail"
                                               placeholder="email@example.com" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="phone" class="form-label">Contact Phone</label>
                                    <InputText id="phone" class="form-control" @bind-Value="model.ContactPhone"
                                               placeholder="+1-555-0100" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="website" class="form-label">Website</label>
                                <InputText id="website" class="form-control" @bind-Value="model.Website"
                                           placeholder="https://example.com" />
                            </div>

                            <div class="mb-3">
                                <label for="address" class="form-label">Address</label>
                                <InputTextArea id="address" class="form-control" rows="2" @bind-Value="model.Address"
                                               placeholder="Street address, city, state, zip code" />
                            </div>

                            <div class="mb-3">
                                <label for="logo" class="form-label">Logo URL</label>
                                <InputText id="logo" class="form-control" @bind-Value="model.LogoUrl"
                                           placeholder="https://example.com/logo.png" />
                                <small class="text-muted">URL to the provider's logo image</small>
                            </div>
                        </div>
                    </div>

                    @if (isEditing)
                    {
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">Version Information</h5>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label for="modifiedBy" class="form-label">Modified By</label>
                                    <InputText id="modifiedBy" class="form-control" @bind-Value="modifiedBy"
                                               placeholder="Your name" />
                                </div>

                                <div class="mb-3">
                                    <label for="changeDescription" class="form-label">Change Description</label>
                                    <InputText id="changeDescription" class="form-control" @bind-Value="changeDescription"
                                               placeholder="Brief description of changes" />
                                </div>

                                <p class="text-muted mb-0">
                                    <small>Current version: @model.Version |
                                        This will create version @(model.Version + 1)</small>
                                </p>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle"></i> @errorMessage
                        </div>
                    }

                    <div class="d-flex gap-2 mb-4">
                        <button type="submit" class="btn btn-primary" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="bi bi-check-lg"></i> @(isEditing ? "Update Provider" : "Create Provider")
                        </button>
                        <a href="/providers" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg"></i> Cancel
                        </a>
                    </div>
                </EditForm>
            </div>

            <div class="col-lg-4">
                <div class="card sticky-top" style="top: 20px;">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-info-circle"></i> Provider Types</h5>
                    </div>
                    <div class="card-body">
                        <dl class="mb-0">
                            <dt>Government</dt>
                            <dd class="text-muted small">General government entity</dd>

                            <dt>Municipal</dt>
                            <dd class="text-muted small">City or local government</dd>

                            <dt>State Agency</dt>
                            <dd class="text-muted small">State-level government agency</dd>

                            <dt>Federal Agency</dt>
                            <dd class="text-muted small">Federal government agency</dd>

                            <dt>Non-Profit</dt>
                            <dd class="text-muted small">Non-profit organization</dd>

                            <dt>Private Contractor</dt>
                            <dd class="text-muted small">Private company under contract</dd>

                            <dt>Public-Private Partnership</dt>
                            <dd class="text-muted small mb-0">Joint public-private entity</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private ServiceProvider model = new();
    private bool isEditing => Id > 0;
    private bool isLoading = true;
    private bool isSaving = false;
    private string errorMessage = string.Empty;
    private string modifiedBy = string.Empty;
    private string changeDescription = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadProvider();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadProvider();
    }

    private async Task LoadProvider()
    {
        isLoading = true;

        if (isEditing)
        {
            var existingProvider = await ProviderRepository.GetByIdAsync(Id);
            if (existingProvider != null)
            {
                model = new ServiceProvider
                {
                    Id = existingProvider.Id,
                    Name = existingProvider.Name,
                    Description = existingProvider.Description,
                    Type = existingProvider.Type,
                    ContactEmail = existingProvider.ContactEmail,
                    ContactPhone = existingProvider.ContactPhone,
                    Website = existingProvider.Website,
                    Address = existingProvider.Address,
                    LogoUrl = existingProvider.LogoUrl,
                    IsActive = existingProvider.IsActive,
                    Version = existingProvider.Version,
                    CreatedAt = existingProvider.CreatedAt
                };
            }
            else
            {
                Navigation.NavigateTo("/providers");
            }
        }
        else
        {
            model = new ServiceProvider
            {
                IsActive = true,
                Type = ProviderType.Government
            };
        }

        isLoading = false;
    }

    private async Task HandleSubmit()
    {
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(model.Name))
        {
            errorMessage = "Provider name is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(model.Description))
        {
            errorMessage = "Description is required.";
            return;
        }

        isSaving = true;

        try
        {
            if (isEditing)
            {
                await ProviderRepository.UpdateAsync(model, modifiedBy, changeDescription);
            }
            else
            {
                await ProviderRepository.AddAsync(model);
            }

            Navigation.NavigateTo("/providers");
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
