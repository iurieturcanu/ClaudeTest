@page "/"

<PageTitle>Admin Dashboard - Public Service Register</PageTitle>

<h1>Admin Dashboard</h1>

<p class="lead">Welcome to the Public Service Register Administration Portal.</p>

<div class="row mt-4">
    <div class="col-md-3">
        <div class="card text-bg-primary mb-3">
            <div class="card-body">
                <h5 class="card-title">Services</h5>
                <p class="card-text">Manage public services offered to citizens.</p>
                <a href="services" class="btn btn-light">View Services</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-success mb-3">
            <div class="card-body">
                <h5 class="card-title">Categories</h5>
                <p class="card-text">Organize services into categories.</p>
                <a href="categories" class="btn btn-light">View Categories</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-info mb-3">
            <div class="card-body">
                <h5 class="card-title">Providers</h5>
                <p class="card-text">Manage service provider organizations.</p>
                <a href="providers" class="btn btn-light">View Providers</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-warning mb-3">
            <div class="card-body">
                <h5 class="card-title">Users</h5>
                <p class="card-text">Manage system users and roles.</p>
                <a href="users" class="btn btn-light">View Users</a>
            </div>
        </div>
    </div>
</div>
